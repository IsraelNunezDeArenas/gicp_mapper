<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gicp_mapper</name>
  <version>0.1.0</version>
  <description>
    Mapeo incremental con GICP (fast_gicp) para ROS 2 Humble.
    Acepta PointCloud2 o LaserScan. Publica mapa global, pose, trayectoria y TF.
    Guarda el mapa en PCD mediante servicio ROS.
  </description>

  <maintainer email="tu@email.com">Tu Nombre</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>laser_geometry</depend>
  <depend>fast_gicp</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libeigen3-dev</depend>
  <depend>vision_msgs</depend>
  <depend>segmentation_msgs</depend>

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
